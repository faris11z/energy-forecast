# Data and artifacts: regenerable, too large for git
data/
mlruns/

# Python
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Models
*.pkl
*.joblib

# Editor / OS
.vscode/
.idea/
.DS_Store

# Secrets: never commit
.env
*.key
# Trained model artifact: regenerate with src/train.py, keeps the repo small
models/

# Extracted .deb packages (libgomp1 and friends) pulled in during setup. The
# runtime that matters is already vendored at .venv/lib/libgomp.so.1, which is
# what LD_LIBRARY_PATH points at. This is 500KB of extracted Linux binaries that
# mean nothing on any other platform.
/.native/

# DVC versioned data and artifacts
.dvc/cache

# Generated metrics belong to DVC, not git (files stay on disk)
reports/train_metrics.json
reports/baseline_metrics.json
/metrics.json

# 3.7MB generated Evidently report, rewritten by every monitor.py run. Tracked from
# session 1 by mistake: history already held ~11MB across 12 blobs and each weekly
# run added another, none of it reclaimable. The signal CI gates on is
# reports/drift.json (4KB), which stays tracked.
/reports/drift.html
